DirectoryIndex index.html index.php

# Portal Sul MA - Configuração de diretório e cache
# Desabilita cache do LiteSpeed para HTML (força revalidação)
<IfModule LiteSpeed>
    CacheDisable public
    CacheDisable private
    RewriteEngine On
    RewriteCond %{REQUEST_URI} \.html$ [OR]
    RewriteCond %{REQUEST_URI} ^/$
    RewriteRule .* - [E=Cache-Control:no-cache,no-store,must-revalidate]
</IfModule>

# Headers de cache para assets estáticos (1 ano)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/json "access plus 1 year"
</IfModule>

# Compressão gzip
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Segurança básica
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Bloqueia acesso a arquivos sensíveis
<FilesMatch "^\.(git|htaccess|htpasswd|env|json|md)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Bloqueia listagem de diretórios
Options -Indexes